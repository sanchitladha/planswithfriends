// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Friend {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  status    String   @default("Not Contacted") // Not Contacted, Email Sent, Waiting for Reply, Dates Received, Match Found, Expressed Interest
  lastEmailSent DateTime?
  lastEmailContent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans     FriendPlan[]
  drafts    EmailDraft[]
}

model FriendPlan {
  id          String   @id @default(uuid())
  friendId    String
  friend      Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  source      String   @default("manual") // manual, email_reply
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MyPlan {
  id          String   @id @default(uuid())
  title       String
  location    String?  // Primary location (for single-location trips)
  startDate   DateTime
  endDate     DateTime?
  description String?
  source      String   @default("manual") // manual, gmail, google_calendar
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  legs        TripLeg[]
}

model TripLeg {
  id          String   @id @default(uuid())
  planId      String
  plan        MyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  location    String
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  order       Int      @default(0) // For ordering legs within a trip
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SharedCalendarEvent {
  id          String   @id @default(uuid())
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  participants String  // JSON array of friend IDs
  matchType   String   // overlap, same_event, nearby
  createdAt   DateTime @default(now())
}

model GoogleAuth {
  id           String   @id @default("default") // Single row for the authenticated user
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailDraft {
  id           String   @id @default(uuid())
  friendId     String
  friend       Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  gmailDraftId String?  // Gmail API draft ID once created
  subject      String
  body         String
  status       String   @default("draft") // draft, pending_review, approved, sent
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
