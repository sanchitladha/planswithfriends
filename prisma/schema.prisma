// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Friend {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  status    String   @default("Not Contacted") // Not Contacted, Email Sent, Waiting for Reply, Dates Received, Match Found, Expressed Interest
  lastEmailSent DateTime?
  lastEmailContent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans     FriendPlan[]
}

model FriendPlan {
  id          String   @id @default(uuid())
  friendId    String
  friend      Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  source      String   @default("manual") // manual, email_reply
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MyPlan {
  id          String   @id @default(uuid())
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  source      String   @default("manual") // manual, gmail, google_calendar
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SharedCalendarEvent {
  id          String   @id @default(uuid())
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  participants String  // JSON array of friend IDs
  matchType   String   // overlap, same_event, nearby
  createdAt   DateTime @default(now())
}
